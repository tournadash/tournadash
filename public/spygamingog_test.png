<script src="/assets/node_modules/jquery-appear-original/index.js?v=0.x"></script>
<script>
	"use strict";

	tlVM['Utils'] = {
		currentPlatform: () => {
			const ua = navigator.userAgent.toLowerCase().replace(/^mozilla\/\d\.\d\W/, '')

			const mobiles = {
				'iphone': /iphone/,
				'ipad': /ipad|macintosh/,
				'android': /android/
			}

			const desktops = {
				'windows': /win/,
				'mac': /macintosh/,
				'linux': /linux/
			}

			const detectPlatform = () => {
				// Determine the operating system
				const mobileOS = Object.keys(mobiles).find(os => mobiles[os].test(ua) && navigator.maxTouchPoints >= 1)
				const desktopOS = Object.keys(desktops).find(os => desktops[os].test(ua))
				const os = mobileOS || desktopOS
				// Extract browser information
				const browserTest = ua.match(/(\w+)\/(\d+\.\d+(?:\.\d+)?(?:\.\d+)?)/g)
				const browserOffset = browserTest && (browserTest.length > 2 && !(/^(ver|cri|gec)/.test(browserTest[1])) ? 1 : 0)
				const browserResult = browserTest && browserTest[browserTest.length - 1 - (browserOffset || 0)].split('/')
				const browser = browserResult && browserResult[0]
				const version = browserResult && browserResult[1]
				return {os, browser, version}
			}

			return detectPlatform();
		},
		numberFormat: function (value, decimals, decPoint, thousandsSep) {
			decPoint = decPoint || '.';
			decimals = (decimals !== undefined ? decimals : 2);
			thousandsSep = thousandsSep || ' ';

			if (typeof value === 'string') {
				value = parseFloat(value);
			}

			let result = value.toLocaleString('en-US', {
				maximumFractionDigits: decimals,
				minimumFractionDigits: decimals
			});

			let pieces = result.split('.');
			pieces[0] = pieces[0].split(',').join(thousandsSep);

			return pieces.join(decPoint);
		},
		/**
		 * Returns the Promise
		 * @param {string | RequestInfo } url
		 * @param {Object|FormData} fBody
		 * @param {Object} fHeaders
		 * @param {string} fMethod
		 * @param {Object} fExtraInit
		 * @returns {Promise}
		 */
		fetchAjax: (url, fBody = {}, fHeaders = {}, fMethod = 'POST', fExtraInit = {}) => {
			const xCsrfTokenName = 'x_csrf_token';
			const currentCaptcha = ko.unwrap(tlVM.captcha.current) ? ko.unwrap(tlVM.captcha.current) : '';
			fHeaders = $.extend({
				'Accept': 'application/json',
				"Content-Type": fBody instanceof FormData ? "application/x-www-form-urlencoded" : "application/json",
			}, fHeaders);

			const init = $.extend({
				method: fMethod,
				credentials: "same-origin",//"include",
				headers: fHeaders,
			}, fExtraInit);
			if (typeof fBody === "object") {
				if (fBody instanceof FormData) {
					if (!fBody.has(xCsrfTokenName)) {
						fBody.append(xCsrfTokenName, '79bafa9b9856cb30dd53f0df3e7882e9c1178203000617');
					}
					fBody.append('current_captcha', currentCaptcha);
				} else {
					fBody = $.extend({
						[xCsrfTokenName]: '79bafa9b9856cb30dd53f0df3e7882e9c1178203000617',
						'current_captcha': currentCaptcha
					}, fBody);
				}
			}
			if (fMethod === 'GET') {
				url += '?' + new URLSearchParams(fBody).toString();
			} else {
				if (fHeaders["Content-Type"] === "multipart/form-data") {
					delete fHeaders["Content-Type"];
				} else {
					fBody = fHeaders["Content-Type"] === "application/json" ? JSON.stringify(fBody) : new URLSearchParams(fBody).toString();
				}
				init.body = fBody;
			}

			return fetch(url, init).then(response => {
								if (response.status === 200) {
					if (response.redirected) {
						return response;
						//window.location.assign(response.url);
					}
					const contentType = response.headers.get("content-type");
					if (contentType && contentType.indexOf("application/json") !== -1) {
						return response.json();
					} else {
						return response.text();
					}
				}

				if ([301, 302, 303, 307, 308].includes(response.status)) {
					return response;
				}

				tlVM.Utils.popupMessage('Server error! Reload the page!');
				throw new Error('Server error! Reload the page!');
			});
		},
		fetchAjaxSimply: (url) => {
															return tlVM.Utils.fetchAjax(url, {'x_csrf_token': 'fff0e27baecb1b5384d0d38d1e2184c3c1178203000629'}, {"Content-Type": "application/x-www-form-urlencoded"});
		},
		popupMessage: function (v) {
			$('.popup3').center();
			$('.content3').html(v);
			$('#popup3').toggle();
		},
		arrayHelper: (obj, key, defaultValue = undefined) => {
			let result = defaultValue;
			if (typeof obj === 'object' && obj.hasOwnProperty(key)) {
				result = obj[key];
			}
			return result;
		},
		popupDialog: {
			confirmModal: [],
			title: ko.observable(),
			type: ko.observable(),
			body: ko.observable(),
			btn: {
				confirm: ko.observable(),
				close: ko.observable(),
				confirmFn: null
			},
			init: () => {
				tlVM.Utils.popupDialog.confirmModal = $('#popupDialog');
				tlVM.Utils.popupDialog.reset();
			},
			reset: () => {
				tlVM.Utils.popupDialog.title('Confirmation');
				tlVM.Utils.popupDialog.type('info');
				tlVM.Utils.popupDialog.body('');
				let btn = tlVM.Utils.popupDialog.btn;
				btn.confirm('Exit');
				btn.close('Close');
				btn.confirmFn = null;
			},
			showDialog: (options = {}) => {
				if (tlVM.Utils.popupDialog.confirmModal.length) {
					tlVM.Utils.popupDialog.type('info');
					Object.keys(options).forEach(k => {
						if (k === 'btn') {
							Object.keys(options.btn).forEach(bk => {
								if (tlVM.Utils.popupDialog.btn.hasOwnProperty(bk)) {
									if (bk !== 'confirmFn') {
										tlVM.Utils.popupDialog.btn[bk](options.btn[bk]);
									} else {
										tlVM.Utils.popupDialog.btn[bk] = options.btn[bk];
									}
								}
							});
						} else if (tlVM.Utils.popupDialog.hasOwnProperty(k)) {
							tlVM.Utils.popupDialog[k](options[k]);
						}
					});
					tlVM.Utils.popupDialog.confirmModal.modal("show");
				}
			},
			getHeaderClass: () => {
				switch (tlVM.Utils.popupDialog.type()) {
					case 'info':
						return 'bg-info';
					case 'success':
						return 'bg-success';
					case 'warning':
						return 'bg-warning';
					case 'error':
						return 'bg-danger';
					case 'danger':
						return 'bg-danger';
					default:
						return 'bg-info';
				}
			},
			confirm: () => {
				if (tlVM.Utils.popupDialog.confirmModal.length) {
					tlVM.Utils.popupDialog.confirmModal.modal("hide");
					if (typeof tlVM.Utils.popupDialog.btn.confirmFn === 'function') {
						tlVM.Utils.popupDialog.btn.confirmFn();
					}
				}
			}
		},
	}

	if (!Date.now) {
		Date.now = function () {
			return new Date().getTime();
		}
	}
	if (!String.format) {
		String.format = function (format) {
			const args = Array.prototype.slice.call(arguments, 1);
			return format.replace(/{(\d+)}/g, function (match, number) {
				return typeof args[number] != 'undefined' ? args[number] : match;
			});
		};
	}

	$(() => {
		$.fn.center = function () {
			this.css("position", "absolute");
			this.css("top", (jQuery(window).height() - this.height()) / 2 + "px");
			this.css("left", (jQuery(window).width() - this.width()) / 2 + "px");
			return this;
		}

		jQuery('.button-close-pops, #popup3').on('click', function (e) {
					jQuery('.content3').empty();
					jQuery('.popups').hide();
				}
		);

		if (typeof (popUpLogin) !== 'undefined' && popUpLogin) {
			jQuery("#login").modal("show");
		}

		tlVM.Utils.popupDialog.init();
	});
