			</div>
		</div>
	</div>

	<script>
		"use strict";

		$(document).on('submit', '.commentForm', function (e) {
			e.preventDefault();
			// Let's keep track of which form we're sending right now
			window._activeCommentForm = this;

			$('#commentCaptchaModal').modal('show');
		});
		$(document).on('shown.bs.modal', '#commentCaptchaModal', function () {
			setTimeout(() => {
				tlVM.captcha.fn.renderCaptcha(
						tlVM.captcha.current(),
						tlVM.captcha.divId + '-comment',
												{},
						submitCommentCaptcha
										);
			}, 10);
		});

		$(document).on('hide.bs.modal', '#commentCaptchaModal', function () {
			tlVM.captcha.fn.renderCaptcha(
					tlVM.captcha.current(),
					tlVM.captcha.divId
			);
		});

		const submitCommentCaptcha = function () {
			const form = window._activeCommentForm;
			if (!form) {
				return;
			}

			// 1. Find the CAPTCHA container in the modal
			const captchaContainer = document.getElementById(tlVM.captcha.divId + '-comment');

			// 2. Collecting ALL hidden CAPTCHA fields
			const captchaFields = captchaContainer.querySelectorAll('input[type="hidden"], textarea');

			// 3. We collect the extraFields into an object
			const extra = {};
			captchaFields.forEach(f => {
				extra[f.name] = f.value;
			});

			// 4. Create an empty FormData object and populate it centrally
			let fd = new FormData();
			fd = tlVM.captcha.fn.appendNeedFields(fd, extra);

			// 5. Transfer everything from FormData to the DOM form
			for (const [name, value] of fd.entries()) {
				let input = form.querySelector(`input[name="${name}"], textarea[name="${name}"]`);
				if (!input) {
					input = document.createElement('input');
					input.type = 'hidden';
					input.name = name;
					form.appendChild(input);
				}
				input.value = value;
			}

			// 6. Let's close the modal
			$('#commentCaptchaModal').modal('hide');

			// 7. Standard POST
			form.submit();

			// 8. Remove the "record" of the last POST request from the browser history
			window._activeCommentForm = null;
			history.replaceState(null, '', location.href);
		};

		$('#commentCaptchaModal input[type="submit"]').on('click', submitCommentCaptcha);
	</script>

	<style>
        #commentCaptchaModal .modal-header,
        #commentCaptchaModal .modal-footer {
            display: none;
        }

        #commentCaptchaModal .modal-dialog {
            margin-top: 20%;
            width: 420px;
        }

