		/**
		 * A local, single-use CAPTCHA solver.
		 * If set, it is called once and automatically reset.
		 *
		 * Examples of use:
		 *
		 * @example <caption>1) Set the handler in advance:</caption>
		 *    tlVM.captcha.onSolvedLocal = function(token, captchaName) {
		 *        console.log('Капча решена:', captchaName, token);
		 *        window._activeCommentForm?.submit();
		 *    };
		 *
		 *    tlVM.captcha.fn.renderCaptcha('recaptcha');
		 *
		 * @example <caption>2) Pass the handler directly to `renderCaptcha`:</caption>
		 *    tlVM.captcha.fn.renderCaptcha(
		 *        'recaptcha',
		 *        'captchaDiv',
		 *        {},
		 *        function(token, captchaName) {
		 *            console.log('Решена:', captchaName, token);
		 *            window._activeCommentForm?.submit();
		 *        }
		 *    );
		 *
		 *
		 * @type {null|function(string, string|null):void}
		 */
		onSolvedLocal: null,

		fn: {

			/**
			 * Shows or hides the message about a problem loading the CAPTCHA.
			 *
			 * @param {string|null} captchaDivId
			 * @param {boolean} remove
			 */
			notCaptchaLoadedMessage: (captchaDivId = null, remove = false) => {
				const noCaptchaId = 'notCaptcha';
				const divNoCaptcha = $(`#${noCaptchaId}`);
				if (divNoCaptcha.length) {
					divNoCaptcha.remove();
				}
				if (!remove) {
					const msg = 'Problem with captcha loading. Try reloading the page or trying a different browser.'
							|| 'Captcha load error!';
					if (!tlVM.captcha.current()) {
						captchaDivId = captchaDivId ? captchaDivId : tlVM.captcha.divId;
						$(`<div id="${noCaptchaId}" class="alert alert-warning">${msg}</div>`)
								.insertAfter($('#' + captchaDivId));
					}
				}
			},

			/**
			 * Sets the current CAPTCHA system by name or index.
			 *
			 * @param {string|number} captcha
			 */
			setCurrent: captcha => {
				let captchaName = '';
				const index = parseInt(captcha);
				if (isNaN(index)) {
					captchaName = captcha;
				} else {
					const systems = Object.keys(tlVM.captcha.systems) || [];
					captchaName = systems.length > index ? systems[index] : '';
				}
				if (captchaName) {
					if (window.hasOwnProperty(tlVM.captcha.systems[captchaName].jsObject)) {
						tlVM.captcha.current(captchaName);
					}
				}
			},

			/**
			 * Returns the name of the next CAPTCHA system.
			 *
			 * @param {boolean} allowMain
			 * @param {boolean} retMainIfEmpty
			 * @returns {string|undefined}
			 */
			getNextCaptcha: (allowMain = false, retMainIfEmpty = false) => {
				let captchaName;
				let systems = Object.keys(tlVM.captcha.systems) || [];
				if (!allowMain) {
					systems = systems.filter(sName => sName !== tlVM.captcha.main);
				}
				const current = tlVM.captcha.current() || tlVM.captcha.main;
				for (let i = 0; i < systems.length; i++) {
					if (systems[i] === current) {
						captchaName = systems[i + 1 >= systems.length ? 0 : i + 1];
						break;
					}
				}
				if (retMainIfEmpty && !captchaName) {
					return tlVM.captcha.main;
