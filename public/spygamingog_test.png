			 */
			renderCaptcha: (captchaName, targetId = null, options = {}, onSolvedCallback = null) => {
				$('#' + (targetId || tlVM.captcha.divId)).html('');
				tlVM.captcha.fn.setCurrent(captchaName);

				const system = tlVM.captcha.systems[captchaName];
				if (system) {
					try {
						const captchaObject = window[system.jsObject];
						if (typeof captchaObject === 'object' && captchaObject.render) {

							const renderOptions = Object.assign({
								sitekey: system.key || ''
							}, system.render.options || {}, options);

							// If a handler is passed, we incorporate it
							if (typeof onSolvedCallback === 'function') {
								tlVM.captcha.onSolvedLocal = onSolvedCallback;
							}
							renderOptions.callback = function (token) {
								tlVM.captcha.fn.onSolved(token, captchaName);
							};

							if (captchaObject.remove) {
								try {
									captchaObject.remove();
								} catch (e) {
								}
							}
							if (captchaObject.reset) {
								try {
									captchaObject.reset();
								} catch (e) {
								}
							}

							if (!targetId) {
								targetId = tlVM.captcha.divId;
							}
							if (document.getElementById(targetId)) {
								const selector = (system.render.addHashSymbol ? '#' : '') + targetId;
								captchaObject.render(selector, renderOptions);
								tlVM.captcha.fn.notCaptchaLoadedMessage(targetId, true);
								return;
							}
						}
					} catch (e) {
					}
				}

				tlVM.captcha.fn.notCaptchaLoadedMessage(targetId);
				tlVM.captcha.fn.setCurrent('');
			},

			/**
			 * Resets the CAPTCHA and clears the local hook.
			 *
			 * @param {string|null} targetId
			 * @param {string|null} captchaName
			 */
			resetCaptcha: (targetId = null, captchaName = null) => {
				tlVM.captcha.onSolvedLocal = null;

				if (!targetId) {
					targetId = tlVM.captcha.divId;
				}
				tlVM.captcha.fn.notCaptchaLoadedMessage(targetId, true);

				captchaName = captchaName || tlVM.captcha.current();
				if (tlVM.captcha.systems[captchaName]) {
					const captcha = tlVM.captcha.systems[captchaName];
					if (typeof window[captcha.jsObject].reset === 'function') {
						window[captcha.jsObject].reset();
					}
				}
			},

			/**
			 * Checks whether the system requires explicit rendering.
			 *
			 * @param {string} captchaName
			 * @returns {boolean}
			 */
			isExplicit: captchaName => {
				return !!((tlVM.captcha.systems[captchaName] || {}).render || {}).explicit;
			},

			/**
			 * Adds CAPTCHA service fields to the request body.
			 *
			 * @param {FormData|Object} fBody
			 * @param {Object<string, any>=} extraFields
			 * @returns {FormData|Object}
			 */
			appendNeedFields: (fBody, extraFields = null) => {
				if (!fBody) {
					return fBody;
				}

				const currentCaptcha = ko.unwrap(tlVM.captcha.current) || '';

				if (fBody instanceof FormData) {
					if (!fBody.has('current_captcha')) {
						fBody.append('current_captcha', currentCaptcha);
					}
					if (extraFields && typeof extraFields === 'object') {
						for (const [name, value] of Object.entries(extraFields)) {
							fBody.append(name, value);
						}
					}
					return fBody;
				}

				if (typeof fBody === 'object') {
					const base = {current_captcha: currentCaptcha};
					if (extraFields && typeof extraFields === 'object') {
						Object.assign(base, extraFields);
					}
					return $.extend(base, fBody);
				}

				return fBody;
			}
		}
	};

	const callNexCaptcha = function (allowMain = false, modal = false, modelSuffix = '-modal') {
		tlVM.viewSpinner(true);
		const id = 'captcha' + (modal ? modelSuffix : '');
		$('#' + id).html('');
		tlVM.captcha.fn.renderCaptcha(tlVM.captcha.fn.getNextCaptcha(allowMain), id, {}, tlVM.captcha.onSolvedLocal);
		tlVM.viewSpinner(false);
	};
	let waitMainCaptchaLoad = setTimeout(callNexCaptcha, Math.max(3000, 10000));

	// noinspection ES6ConvertVarToLetConst
	var onloadMainCaptchaCallback = function () {
		const captchaJsObjectName = tlVM.captcha.systems[tlVM.captcha.main].jsObject;
		if (!window.hasOwnProperty(captchaJsObjectName) || !window[captchaJsObjectName].hasOwnProperty('render')) {
			return;
		}
		if (waitMainCaptchaLoad) {
			clearTimeout(waitMainCaptchaLoad);
		}
		if (!tlVM.captcha.current()) {
			tlVM.captcha.fn.renderCaptcha(tlVM.captcha.main);
			tlVM.viewSpinner(false);
		}

		if (!tlVM.captcha.current()) {
			tlVM.viewSpinner(true);
			waitMainCaptchaLoad = setTimeout(callNexCaptcha, Math.max(3000, 10000));
		}
	};


	$(() => {
				if (!tlVM.captcha.current() && document.getElementById(tlVM.captcha.divId)) {
			tlVM.viewSpinner(true);
		}
	});
