	<script type="text/javascript">
	tlVM.captcha = {
		systems: JSON.parse('{"turnstile":{"disabled":false,"forOS":["default"],"render":{"explicit":true,"addHashSymbol":true,"options":{"theme":"light","language":"en"}},"key":"0x4AAAAAAApvOosR2lBQBeAW","script":"https:\/\/challenges.cloudflare.com\/turnstile\/v0\/api.js?onload=onloadMainCaptchaCallback&render=explicit","jsObject":"turnstile"},"hcaptcha":{"disabled":false,"forOS":["default","oldWindows"],"render":{"explicit":true,"addHashSymbol":false,"options":{"theme":"light","language":"en"}},"key":"aa37d243-018d-4d7b-94ec-4c28bc8bb098","script":"https:\/\/hcaptcha.com\/1\/api.js?onload=onloadMainCaptchaCallback&recaptchacompat=off&render=explicit&hl=en","jsObject":"hcaptcha"},"recaptcha":{"disabled":false,"forOS":["default","oldWindows"],"render":{"explicit":true,"addHashSymbol":false,"options":{"theme":"light","language":"en"}},"key":"6LfVF3gqAAAAAEo-CyjQvDSuk3bT8k9wsepiVdHK","script":"https:\/\/www.google.com\/recaptcha\/api.js?onload=onloadMainCaptchaCallback&render=explicit&hl=en","jsObject":"grecaptcha"}}' || '[]'),
		divId: 'captcha' || 'captcha',
