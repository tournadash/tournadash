<script src='/assets/node_modules/knockout/build/output/knockout-latest.js?v=3.x'></script>

<script>
	"use strict";

	const lang = 'en';


	const tlVM = {
		lang: 'en',
		mainLang: 'en',
		authInfo: {},
		user: {},
		data: {},
		acc: {},
		dataObjectLoaded: ko.observable(),
		viewSpinner: ko.observable(false),
		popupDialog: {
			title: ko.observable(),
			body: ko.observable(''),
			footer: ko.observable(),
		},
		loadFromDatObject: dataObject => {
			if (dataObject && dataObject.tlVM) {
				['data', 'acc', 'authInfo', 'user'].forEach(loadKey => {
					if (dataObject.tlVM.hasOwnProperty(loadKey)) {
						Object.keys(dataObject.tlVM[loadKey]).forEach(k => {
							tlVM[loadKey][k] = dataObject.tlVM[loadKey][k];
						});
					}
				});

				afterLoadDataObjectHandler();
				tlVM.dataObjectLoaded(true);
			}
		},
	}

	function afterLoadDataObjectHandler() {
		//delete tlVM.dataObjectLoaded;

				['data', 'authInfo', 'user'].forEach(i => {
			function getSimpleValue(v) {
				if (typeof v === 'string' && v.length > 0 && v.match(/\D+/g) === null) {
					return parseInt(v);
				}
				return v;
			}

			Object.keys(tlVM[i]).forEach(dk => {
				switch (true) {
					case Array.isArray(tlVM[i][dk]):
						tlVM[i][dk] = ko.observableArray(tlVM[i][dk]);
						break;
					case tlVM[i][dk] instanceof Object:
						Object.keys(tlVM[i][dk]).forEach(ok => {
							if (Array.isArray(tlVM[i][dk][ok])) {
								tlVM[i][dk][ok] = ko.observableArray(tlVM[i][dk][ok]);
							} else {
								tlVM[i][dk][ok] = ko.observable(getSimpleValue(tlVM[i][dk][ok]));
							}
						});
						break;
					default:
						tlVM[i][dk] = ko.observable(getSimpleValue(tlVM[i][dk]));
				}
			})
		});

		tlVM.user.isForever = ko.pureComputed(() => {
			const currentTS = new Date();
			return parseInt(tlVM.user.group()) === 2 && tlVM.user.goldtime() > Math.floor(currentTS.setDate(currentTS.getDate() + 500) / 1000);
		});

			}

	jQuery.ajax({
		async: true,
		url: "/en/ajax/getdataobject/",
		data: {
			'lang': 'en',
			'x_csrf_token': 'fff0e27baecb1b5384d0d38d1e2184c3c1178203000629',
			'userId': '' || -1,
		},
		method: "POST",
		success: function (responseData) {
						if (responseData.status === 'ok') {
				tlVM.loadFromDatObject(responseData);
			}
		}
	});
</script>
